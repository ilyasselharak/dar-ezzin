# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dar_ezzin?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://darezzin.ma"
NEXT_PUBLIC_SITE_URL="https://darezzin.ma"

# Storage driver: "r2" in production, "local" for development without R2
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dar-ezzin-images"
# Public delivery domain bound to the R2 bucket (Cloudflare custom domain)
NEXT_PUBLIC_IMAGE_BASE_URL="https://images.darezzin.ma"
# "true" when Cloudflare Image Transformations are enabled on the zone
# (serves resized AVIF/WebP via /cdn-cgi/image/...)
NEXT_PUBLIC_CF_IMAGE_TRANSFORMS="true"

# Used by `npm run db:seed` to create the first administrator
SEED_ADMIN_EMAIL="admin@darezzin.ma"
SEED_ADMIN_PASSWORD=""

# Electro Darna catalog link (Convex HTTP URL, ends with .convex.site)
ELECTRODARNA_API_URL=
# Same value as CATALOG_SHARE_KEY in the Electro Darna Convex env
ELECTRODARNA_API_KEY=
# Protects /api/cron/electrodarna-sync (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
